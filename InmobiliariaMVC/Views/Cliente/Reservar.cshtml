@model InmobiliariaMVC.Models.ReservaViewModel

@{
    ViewData["Title"] = "Reservar Visita";
}

<div class="container-main">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex align-items-center mb-4">
                <a asp-controller="Propiedades" asp-action="Detalle" asp-route-id="@Model.IdPropiedad"
                   class="btn btn-outline-primary me-3">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h1 class="mb-0">Reservar Visita</h1>
            </div>

            @* ===== RESUMEN DE LA PROPIEDAD ===== *@
            <div class="card mb-4">
                <div class="row g-0">
                    @if (!string.IsNullOrEmpty(Model.UrlImagen))
                    {
                        <div class="col-md-4">
                            <img src="@Model.UrlImagen" alt="@Model.Tipo en @Model.Zona"
                                 class="img-fluid rounded-start" style="height:100%;width:100%;object-fit:cover;" />
                        </div>
                    }
                    <div class="col-md-@(string.IsNullOrEmpty(Model.UrlImagen) ? "12" : "8")">
                        <div class="card-body">
                            <h5 class="card-title">@Model.Tipo en @Model.Zona</h5>
                            <p class="text-muted mb-1"><i class="bi bi-geo-alt"></i> @Model.Direccion</p>
                            <p class="mb-0" style="font-weight:700;color:var(--walnut-brown);">
                                @Model.Moneda @Model.Precio.ToString("N2")
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            @* ===== FORMULARIO ===== *@
            <div class="form-card">
                <h4 class="mb-3">Elige fecha y hora</h4>

                <form asp-action="Reservar" method="post">
                    <input type="hidden" asp-for="IdPropiedad" />
                    <input type="hidden" asp-for="UrlImagen" />
                    <input type="hidden" asp-for="Tipo" />
                    <input type="hidden" asp-for="Zona" />
                    <input type="hidden" asp-for="Direccion" />
                    <input type="hidden" asp-for="Precio" />
                    <input type="hidden" asp-for="Moneda" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Fecha" class="form-label">Fecha de la visita</label>
                            <input asp-for="Fecha" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   class="form-control" />
                            <span asp-validation-for="Fecha" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="HoraInicio" class="form-label">Hora de la visita</label>
                            <input asp-for="HoraInicio" type="time" min="08:00" max="22:00"
                                   class="form-control" />
                            <span asp-validation-for="HoraInicio" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Observaciones" class="form-label">Observaciones (opcional)</label>
                            <textarea asp-for="Observaciones" class="form-control" rows="3"
                                      placeholder="Cuéntale al agente qué te interesa de la propiedad"></textarea>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-calendar-check"></i> Confirmar Reserva
                        </button>
                        <a asp-controller="Propiedades" asp-action="Index" class="btn btn-outline-primary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>