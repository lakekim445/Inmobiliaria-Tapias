@model List<InmobiliariaMVC.Models.CitaResumenDTO>

@{
    ViewData["Title"] = "Mis Citas";
}

<div class="container-main">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Mis Citas</h1>
        <div class="d-flex gap-2">
            <a asp-controller="Propiedades" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Reservar Visita
            </a>
        </div>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert-success-custom">
            <i class="bi bi-check-circle"></i> @TempData["MensajeExito"]
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert-error-custom">
            <i class="bi bi-exclamation-triangle"></i> @TempData["MensajeError"]
        </div>
    }

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Hora</th>
                    <th>Propiedad</th>
                    <th>Agente</th>
                    <th>Observaciones</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            No tienes citas agendadas.
                            <a asp-controller="Propiedades" asp-action="Index">Reserva una visita</a> para ver una propiedad.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var cita in Model)
                    {
                        <tr>
                            <td>@cita.FechaCita.ToString("dd/MM/yyyy")</td>
                            <td>@cita.HoraInicio.ToString(@"hh\:mm") — @cita.HoraFin.ToString(@"hh\:mm")</td>
                            <td>
                                <strong>@cita.PropiedadTipo</strong> en @cita.PropiedadZona
                                <div class="text-muted small">@cita.PropiedadDireccion</div>
                            </td>
                            <td>@(cita.AgenteNombre ?? "-")</td>
                            <td>@(cita.Observaciones ?? "-")</td>
                            <td>
                                <span class="badge-@(cita.EstadoNombre == "Pendiente" ? "disponible" : cita.EstadoNombre == "Confirmada" ? "reservado" : "vendido")">@cita.EstadoNombre</span>
                            </td>
                            <td>
                                @if (cita.EstadoNombre == "Pendiente" || cita.EstadoNombre == "Confirmada")
                                {
                                    <form asp-action="Cancelar" asp-route-id="@cita.Id" method="post"
                                          onsubmit="return confirm('¿Cancelar esta cita?');" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-action btn-action-danger" title="Cancelar cita">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>