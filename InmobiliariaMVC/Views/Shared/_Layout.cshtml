<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tapia's Solution</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Nunito+Sans:wght@300;400;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <!-- Estilos personalizados -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InmobiliariaMVC.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- ============================================================
         NAVBAR
         ============================================================ -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container-fluid px-4">
             <a class="navbar-brand logo-tapia"
                   asp-controller="Home"
                   asp-action="Index">
                    <img src="/images/logo-tapias-transparente.png"
                         alt="Tapia's Solution">
             </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house"></i> Inicio
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                        <i class="bi bi-speedometer2"></i> Panel Admin
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Agente"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Agente" asp-action="Index">
                                        <i class="bi bi-briefcase"></i> Panel Agente
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Cliente"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Cliente" asp-action="Index">
                                        <i class="bi bi-person"></i> Mi Panel
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="nav-link">
                                    <i class="bi bi-person-circle"></i> Hola, @User.Identity.Name
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link">
                                        <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- ============================================================
         CONTENIDO PRINCIPAL
         ============================================================ -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- ============================================================
         FOOTER
         ============================================================ -->
    <footer class="footer">
        <div class="container">
            <div class="row footer-columns">
                <div class="col-md-4 mb-3 mb-lg-0">
                    <h5 class="footer-title">Horarios</h5>
                    <p class="footer-text"><i class="bi bi-clock"></i> Lun a Dom</p>
                    <p class="footer-text">9:00 AM a 6:00 PM</p>
                </div>

                <div class="col-md-4 mb-3 mb-lg-0">
                    <h5 class="footer-title">Oficina</h5>
                    <p class="footer-text"><i class="bi bi-geo-alt"></i> Cochabamba, Bolivia</p>
                    <a href="https://maps.app.goo.gl/jb2g7p2X9hqTL6o17" target="_blank" rel="noopener">
                        <i class="bi bi-map"></i> Ver en Google Maps
                    </a>
                </div>

                <div class="col-md-4">
                    <h5 class="footer-title">Contacto</h5>
                    <div class="footer-social">
                        <a href="https://wa.me/59169172830" target="_blank" rel="noopener" title="WhatsApp +591 69172830">
                            <i class="bi bi-whatsapp"></i>
                        </a>
                        <a href="https://www.facebook.com/share/1HmqoGDtrb/" target="_blank" rel="noopener" title="Facebook">
                            <i class="bi bi-facebook"></i>
                        </a>
                        <a href="https://www.instagram.com/tapiasolution?stkn=NXRxem8xNHoxazJ1" target="_blank" rel="noopener" title="Instagram">
                            <i class="bi bi-instagram"></i>
                        </a>
                    </div>
                </div>
            </div>

            <hr class="footer-divider">

            <p class="footer-copy">&copy; @DateTime.Now.Year - Tapia's Solution | Inmobiliaria en Cochabamba, Bolivia</p>
        </div>
    </footer>

    <!-- ============================================================
         SCRIPTS
         ============================================================ -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>