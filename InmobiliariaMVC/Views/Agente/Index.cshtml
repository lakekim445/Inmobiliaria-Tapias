@{
    ViewData["Title"] = "Panel Agente";
}

<div class="container-main">
    <h1 class="mb-4">Panel del Agente</h1>
    <p class="lead">Bienvenido, <strong>@User.Identity?.Name</strong></p>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h5 class="text-muted">Mis Propiedades</h5>
                <h2 class="text-dark">@ViewBag.TotalPropiedades</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h5 class="text-muted">Disponibles</h5>
                <h2 class="text-dark">@ViewBag.Disponibles</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h5 class="text-muted">Vendidas</h5>
                <h2 class="text-dark">@ViewBag.Vendidas</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center p-3">
                <h5 class="text-muted">Alquiladas</h5>
                <h2 class="text-dark">@ViewBag.Alquiladas</h2>
            </div>
        </div>
    </div>

    <div class="card p-4 mb-4">
        <h5>Mi Comisión Total</h5>
        <h2 class="text-success">$@(((decimal)ViewBag.ComisionTotal).ToString("N2"))</h2>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <a asp-action="CrearPropiedad" class="btn btn-primary w-100">
                <i class="bi bi-plus-circle"></i> Registrar Nueva Propiedad
            </a>
        </div>
        <div class="col-md-6">
            <a asp-action="MisPropiedades" class="btn btn-secondary w-100">
                <i class="bi bi-list"></i> Ver Mis Propiedades
            </a>
        </div>
    </div>
</div>