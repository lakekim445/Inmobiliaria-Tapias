@model InmobiliariaMVC.Models.PropiedadCreateViewModel

@{
    ViewData["Title"] = "Registrar Propiedad";
}

<div class="container-main">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Registrar Nueva Propiedad</h1>
        <a asp-action="MisPropiedades" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <div class="card form-card" style="max-width: 800px;">
        <form asp-action="CrearPropiedad" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Tipo" class="form-label">Tipo de Propiedad</label>
                    <select asp-for="Tipo" class="form-control">
                        <option value="">-- Selecciona --</option>
                        <option value="Casa">Casa</option> 