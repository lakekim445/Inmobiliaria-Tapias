@model InmobiliariaMVC.Models.PropiedadCreateViewModel

@{
    ViewData["Title"] = "Registrar Propiedad";
}

<div class="container-main">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Registrar Nueva Propiedad</h1>
        <a asp-action="MisPropiedades" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <div class="card form-card" style="max-width: 800px;">
        <form asp-action="CrearPropiedad" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Tipo" class="form-label">
                        <i class="bi bi-house-door"></i> Tipo de Propiedad
                    </label>
                    <select asp-for="Tipo" class="form-control">
                        <option value="">-- Selecciona --</option>
                        <option value="Casa">Casa</option>
                        <option value="Departamento">Departamento</option>
                        <option value="Terreno">Terreno</option>
                    </select>
                    <span asp-validation-for="Tipo" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Moneda" class="form-label">
                        <i class="bi bi-currency-dollar"></i> Moneda
                    </label>
                    <select asp-for="Moneda" class="form-control">
                        <option value="USD">USD</option>
                        <option value="Bs">Bs</option>
                    </select>
                    <span asp-validation-for="Moneda" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Precio" class="form-label">
                    <i class="bi bi-cash"></i> Precio
                </label>
                <input asp-for="Precio" type="number" step="0.01" class="form-control" placeholder="Ej: 150000" />
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Zona" class="form-label">
                    <i class="bi bi-geo-alt"></i> Zona / Barrio
                </label>
                <input asp-for="Zona" class="form-control" placeholder="Ej: Calacoto" />
                <span asp-validation-for="Zona" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Direccion" class="form-label">
                    <i class="bi bi-pin-map"></i> Dirección
                </label>
                <input asp-for="Direccion" class="form-control" placeholder="Ej: Calle 15 #456" />
                <span asp-validation-for="Direccion" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label">
                    <i class="bi bi-card-text"></i> Descripción
                </label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"
                          placeholder="Describe la propiedad con detalle..."></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Habitaciones" class="form-label">
                        <i class="bi bi-door-closed"></i> Habitaciones
                    </label>
                    <input asp-for="Habitaciones" type="number" class="form-control" min="0" />
                    <span asp-validation-for="Habitaciones" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Banos" class="form-label">
                        <i class="bi bi-droplet"></i> Baños
                    </label>
                    <input asp-for="Banos" type="number" class="form-control" min="0" />
                    <span asp-validation-for="Banos" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="SuperficieM2" class="form-label">
                        <i class="bi bi-rulers"></i> Superficie (m²)
                    </label>
                    <input asp-for="SuperficieM2" type="number" step="0.01" class="form-control" min="0" />
                    <span asp-validation-for="SuperficieM2" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">
                    <i class="bi bi-images"></i> Imágenes de la Propiedad
                </label>
                <input type="file" name="imagenes" multiple accept="image/*" class="form-control" />
                <small class="text-muted">
                    Puedes seleccionar varias imágenes a la vez. Formatos permitidos: JPG, PNG.
                </small>
            </div>

            <div class="form-actions">
                <a asp-action="MisPropiedades" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Registrar Propiedad
                </button>
            </div>
        </form>
    </div>
</div>