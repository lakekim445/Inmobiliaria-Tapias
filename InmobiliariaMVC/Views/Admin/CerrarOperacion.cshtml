@model InmobiliariaMVC.Models.CerrarOperacionViewModel

@{
    ViewData["Title"] = "Cerrar Operación";
}

<div class="container-main">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Cerrar Operación</h1>
        <a asp-action="Propiedades" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <div class="card form-card">
        <form asp-action="CerrarOperacion" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="NombrePropiedad" />
            <input type="hidden" asp-for="PrecioPublicado" />
            <input type="hidden" asp-for="Moneda" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="alert-info-custom mb-3">
                <strong>Propiedad:</strong> @Model.NombrePropiedad<br />
                <strong>Precio publicado:</strong> @Model.Moneda @Model.PrecioPublicado.ToString("N2")
            </div>

            <div class="mb-3">
                <label asp-for="TipoOperacion" class="form-label">
                    <i class="bi bi-tag"></i> Tipo de Operación
                </label>
                <select asp-for="TipoOperacion" class="form-control" id="tipoOperacion">
                    <option value="">-- Selecciona --</option>
                    <option value="Venta">Venta (5% empresa, 1% agente)</option>
                    <option value="Alquiler">Alquiler (5% empresa, 1% agente)</option>
                    <option value="Anticretico">Anticrético (3% empresa, 0.5% agente)</option>
                </select>
                <span asp-validation-for="TipoOperacion" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PrecioFinal" class="form-label">
                    <i class="bi bi-cash"></i> Precio Final
                </label>
                <input asp-for="PrecioFinal" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="PrecioFinal" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Observaciones" class="form-label">
                    <i class="bi bi-chat-text"></i> Observaciones (opcional)
                </label>
                <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
            </div>

            <div id="calculoComision" class="alert-info-custom mb-3" style="display:none;">
                <h5>Cálculo automático:</h5>
                <p class="mb-1">Comisión Empresa: <strong id="comisionEmpresa">$0</strong></p>
                <p class="mb-1">Comisión Agente: <strong id="comisionAgente">$0</strong></p>
                <p class="mb-0">Ganancia Neta: <strong id="gananciaNeta">$0</strong></p>
            </div>

            <div class="form-actions">
                <a asp-action="Propiedades" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Confirmar Cierre
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function calcularComision() {
            const tipo = document.getElementById('tipoOperacion').value;
            const precio = parseFloat(document.getElementById('PrecioFinal').value) || 0;

            let empresaPorc = 0;
            let agentePorc = 0;

            if (tipo === 'Venta' || tipo === 'Alquiler') {
                empresaPorc = 5;
                agentePorc = 1;
            } else if (tipo === 'Anticretico') {
                empresaPorc = 3;
                agentePorc = 0.5;
            }

            if (empresaPorc > 0 && precio > 0) {
                const comisionEmpresa = precio * empresaPorc / 100;
                const comisionAgente = precio * agentePorc / 100;
                const gananciaNeta = comisionEmpresa - comisionAgente;

                document.getElementById('comisionEmpresa').textContent = '$' + comisionEmpresa.toFixed(2);
                document.getElementById('comisionAgente').textContent = '$' + comisionAgente.toFixed(2);
                document.getElementById('gananciaNeta').textContent = '$' + gananciaNeta.toFixed(2);
                document.getElementById('calculoComision').style.display = 'block';
            } else {
                document.getElementById('calculoComision').style.display = 'none';
            }
        }

        document.getElementById('tipoOperacion').addEventListener('change', calcularComision);
        document.getElementById('PrecioFinal').addEventListener('input', calcularComision);
    </script>
}