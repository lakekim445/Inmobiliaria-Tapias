@model List<InmobiliariaMVC.Models.AgenteResumenDTO>

@{
    ViewData["Title"] = "Agentes";
}

<div class="container-main">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Agentes Inmobiliarios</h1>
        <a asp-action="CrearAgente" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Crear Agente
        </a>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success-custom">
            <i class="bi bi-check-circle"></i> @TempData["MensajeExito"]
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-error-custom">
            <i class="bi bi-exclamation-triangle"></i> @TempData["MensajeError"]
        </div>
    }

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                    <th>Propiedades</th>
                    <th>Vendidas</th>
                    <th>Comisión Total</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-4">
                            <i class="bi bi-inbox" style="font-size:2rem;color:#B3A48F;"></i>
                            <p class="mt-2 mb-0">No hay agentes registrados</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var agente in Model)
                    {
                        <tr>
                            <td>
                                <strong>@agente.NombreCompleto</strong>
                            </td>
                            <td>@agente.Email</td>
                            <td>@agente.Telefono</td>
                            <td>
                                <span class="badge-count">@agente.TotalPropiedades</span>
                            </td>
                            <td>
                                <span class="badge-count">@agente.PropiedadesVendidas</span>
                            </td>
                            <td>
                                <strong style="color:#6B6B43;">$@agente.ComisionTotal.ToString("N2")</strong>
                            </td>
                            <td>
                                @if (agente.Activo)
                                {
                                    <span class="badge-disponible">Activo</span>
                                }
                                else
                                {
                                    <span class="badge-vendido">Inactivo</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="DetalleAgente" asp-route-id="@agente.Id"
                                       class="btn-action" title="Ver detalle">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="EditarAgente" asp-route-id="@agente.Id"
                                       class="btn-action" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="EliminarAgente" asp-route-id="@agente.Id" method="post"
                                          onsubmit="return confirm('¿Estás seguro de eliminar este agente?');"
                                          style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-action btn-action-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>