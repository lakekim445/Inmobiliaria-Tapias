@model InmobiliariaMVC.Models.AgenteDetalleDTO

@{
    ViewData["Title"] = "Detalle del Agente";
}

<div class="container-main">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Detalle del Agente</h1>
        <a asp-action="Agentes" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <div class="card form-card">
        <div class="detail-row">
            <span class="detail-label"><i class="bi bi-person"></i> Nombre:</span>
            <span class="detail-value">@Model.NombreCompleto</span>
        </div>

        <div class="detail-row">
            <span class="detail-label"><i class="bi bi-envelope"></i> Email:</span>
            <span class="detail-value">@Model.Email</span>
        </div>

        <div class="detail-row">
            <span class="detail-label"><i class="bi bi-telephone"></i> Teléfono:</span>
            <span class="detail-value">@Model.Telefono</span>
        </div>

        <div class="detail-row">
            <span class="detail-label"><i class="bi bi-shield-check"></i> Rol:</span>
            <span class="detail-value">@Model.NombreRol</span>
        </div>

        <div class="detail-row">
            <span class="detail-label"><i class="bi bi-toggle-on"></i> Estado:</span>
            <span class="detail-value">
                @if (Model.Activo)
                {
                    <span class="badge-disponible">Activo</span>
                }
                else
                {
                    <span class="badge-vendido">Inactivo</span>
                }
            </span>
        </div>

        <div class="detail-row">
            <span class="detail-label"><i class="bi bi-calendar"></i> Fecha registro:</span>
            <span class="detail-value">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</span>
        </div>

        <div class="form-actions">
            <a asp-action="EditarAgente" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Editar
            </a>
        </div>
    </div>
</div>