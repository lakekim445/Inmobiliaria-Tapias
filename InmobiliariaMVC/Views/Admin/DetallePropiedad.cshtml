@model InmobiliariaMVC.Models.PropiedadResumenDTO

@{
    ViewData["Title"] = "Detalle de Propiedad";
}

<div class="container-main">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Detalle de Propiedad</h1>
        <a asp-action="Propiedades" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <div class="card form-card" style="max-width: 800px;">

        @if (!string.IsNullOrEmpty(Model.UrlImagenPrincipal))
        {
            <div class="mb-4" style="text-align:center;">
                <img src="@Model.UrlImagenPrincipal" alt="Imagen de la propiedad"
                     style="max-width:100%; max-height:300px; border-radius:12px; border:2px solid #B3A48F;" />
            </div>
        }
        else
        {
            <div class="mb-4" style="text-align:center;">
                <div style="background-color:#F2EBDD; padding:3rem; border-radius:12px; border:2px dashed #B3A48F;">
                    <i class="bi bi-image" style="font-size:3rem; color:#B3A48F;"></i>
                    <p class="text-muted mt-2 mb-0">Sin imagen</p>
                </div>
            </div>
        }

        <div class="detail-row">
            <span class="detail-label"><i class="bi bi-house-door"></i> Tipo:</span>
            <span class="detail-value">@Model.Tipo</span>
        </div>

        <div class="detail-row">
            <span class="detail-label"><i class="bi bi-cash"></i> Precio:</span>
            <span class="detail-value">
                <strong style="color:#6B6B43; font-size:1.2rem;">
                    @Model.Moneda @Model.Precio.ToString("N2")
                </strong>
            </span>
        </div>

        <div class="detail-row">
            <span class="detail-label"><i class="bi bi-toggle-on"></i> Estado:</span>
            <span class="detail-value">
                @if (Model.Estado == "Disponible")
                {
                    <span class="badge-disponible">@Model.Estado</span>
                }
                else if (Model.Estado == "Reservado")
                {
                    <span class="badge-reservado">@Model.Estado</span>
                }
                else
                {
                    <span class="badge-vendido">@Model.Estado</span>
                }
            </span>
        </div>

        <div class="detail-row">
            <span class="detail-label"><i class="bi bi-geo-alt"></i> Zona:</span>
            <span class="detail-value">@Model.Zona</span>
        </div>

        <div class="detail-row">
            <span class="detail-label"><i class="bi bi-pin-map"></i> Dirección:</span>
            <span class="detail-value">@Model.Direccion</span>
        </div>

        @if (Model.Habitaciones > 0)
        {
            <div class="detail-row">
                <span class="detail-label"><i class="bi bi-door-closed"></i> Habitaciones:</span>
                <span class="detail-value">@Model.Habitaciones</span>
            </div>
        }

        @if (Model.Banos > 0)
        {
            <div class="detail-row">
                <span class="detail-label"><i class="bi bi-droplet"></i> Baños:</span>
                <span class="detail-value">@Model.Banos</span>
            </div>
        }

        @if (Model.SuperficieM2.HasValue)
        {
            <div class="detail-row">
                <span class="detail-label"><i class="bi bi-rulers"></i> Superficie:</span>
                <span class="detail-value">@Model.SuperficieM2.Value.ToString("N2") m²</span>
            </div>
        }

        <div class="detail-row">
            <span class="detail-label"><i class="bi bi-person-badge"></i> Agente:</span>
            <span class="detail-value">@Model.NombreAgente</span>
        </div>

        <div class="detail-row">
            <span class="detail-label"><i class="bi bi-calendar"></i> Fecha publicación:</span>
            <span class="detail-value">@Model.FechaPublicacion.ToString("dd/MM/yyyy")</span>
        </div>

        @if (!string.IsNullOrEmpty(Model.TipoOperacion))
        {
            <div class="alert-success-custom mt-4">
                <i class="bi bi-check-circle"></i> <strong>Operación cerrada</strong>
            </div>

            <div class="detail-row">
                <span class="detail-label"><i class="bi bi-tag"></i> Tipo operación:</span>
                <span class="detail-value"><strong>@Model.TipoOperacion</strong></span>
            </div>

            @if (Model.FechaCierre.HasValue)
            {
                <div class="detail-row">
                    <span class="detail-label"><i class="bi bi-calendar-check"></i> Fecha cierre:</span>
                    <span class="detail-value">@Model.FechaCierre.Value.ToString("dd/MM/yyyy")</span>
                </div>
            }

            @if (Model.ComisionEmpresaPorcentaje.HasValue)
            {
                <div class="detail-row">
                    <span class="detail-label"><i class="bi bi-percent"></i> % Empresa:</span>
                    <span class="detail-value">@Model.ComisionEmpresaPorcentaje.Value.ToString("N2")%</span>
                </div>
            }

            @if (Model.ComisionAgentePorcentaje.HasValue)
            {
                <div class="detail-row">
                    <span class="detail-label"><i class="bi bi-percent"></i> % Agente:</span>
                    <span class="detail-value">@Model.ComisionAgentePorcentaje.Value.ToString("N2")%</span>
                </div>
            }
        }

        <div class="form-actions">
            @if (string.IsNullOrEmpty(Model.TipoOperacion))
            {
                <a asp-action="CerrarOperacion" asp-route-id="@Model.Id" class="btn btn-secondary">
                    <i class="bi bi-cash-coin"></i> Cerrar Operación
                </a>
            }
            <a asp-action="EditarPropiedad" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Editar Propiedad
            </a>
        </div>
    </div>
</div>