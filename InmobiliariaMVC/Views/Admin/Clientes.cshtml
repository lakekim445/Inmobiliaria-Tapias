@model List<InmobiliariaMVC.Models.ClienteResumenDTO>

@{
    ViewData["Title"] = "Clientes";
}

<div class="container-main">
    <h1 class="mb-4">Clientes Registrados</h1>

    <div class="card mb-4">
        <p class="text-muted mb-0">
            <i class="bi bi-info-circle"></i>
            Los clientes se registran automáticamente desde la página pública. Aquí puedes supervisar sus datos.
        </p>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="card text-center py-4">
            <i class="bi bi-inbox" style="font-size:3rem;color:#B3A48F;"></i>
            <p class="mt-3 mb-0">No hay clientes registrados</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>Teléfono</th>
                        <th>Estado</th>
                        <th>Fecha Registro</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cliente in Model)
                    {
                        <tr>
                            <td><strong>@cliente.NombreCompleto</strong></td>
                            <td>@cliente.Email</td>
                            <td>@cliente.Telefono</td>
                            <td><span class="badge-disponible">@cliente.EstadoProspecto</span></td>
                            <td>@cliente.FechaRegistro.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>