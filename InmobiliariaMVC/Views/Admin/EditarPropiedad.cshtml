@model InmobiliariaMVC.Models.PropiedadUpdateViewModel

@{
    ViewData["Title"] = "Editar Propiedad";
}

<div class="container-main">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Editar Propiedad</h1>
        <a asp-action="Propiedades" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <div class="card form-card" style="max-width: 800px;">
        <form asp-action="EditarPropiedad" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Tipo" class="form-label">Tipo</label>
                    <select asp-for="Tipo" class="form-control">
                        <option value="Casa">Casa</option>
                        <option value="Departamento">Departamento</option>
                        <option value="Terreno">Terreno</option>
                    </select>
                    <span asp-validation-for="Tipo" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Estado" class="form-label">Estado</label>
                    <select asp-for="Estado" class="form-control">
                        <option value="Disponible">Disponible</option>
                        <option value="Reservado">Reservado</option>
                        <option value="Vendido">Vendido</option>
                        <option value="Alquilado">Alquilado</option>
                        <option value="Anticretico">Anticrético</option>
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="col-md-8 mb-3">
                    <label asp-for="Precio" class="form-label">Precio</label>
                    <input asp-for="Precio" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Precio" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Moneda" class="form-label">Moneda</label>
                    <select asp-for="Moneda" class="form-control">
                        <option value="USD">USD</option>
                        <option value="Bs">Bs</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Zona" class="form-label">Zona</label>
                <input asp-for="Zona" class="form-control" />
                <span asp-validation-for="Zona" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Direccion" class="form-label">Dirección</label>
                <input asp-for="Direccion" class="form-control" />
                <span asp-validation-for="Direccion" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label">Descripción</label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Habitaciones" class="form-label">Habitaciones</label>
                    <input asp-for="Habitaciones" type="number" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Banos" class="form-label">Baños</label>
                    <input asp-for="Banos" type="number" class="form-control" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="SuperficieM2" class="form-label">Superficie (m²)</label>
                    <input asp-for="SuperficieM2" type="number" step="0.01" class="form-control" />
                </div>
            </div>

            <div class="form-actions">
                <a asp-action="Propiedades" class="btn btn-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Guardar Cambios
                </button>
            </div>
        </form>
    </div>
</div>