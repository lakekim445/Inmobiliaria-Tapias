@model List<InmobiliariaMVC.Models.PropiedadResumenDTO>

@{
    ViewData["Title"] = "Propiedades";
}

<div class="container-main">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Todas las Propiedades</h1>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert-success-custom">
            <i class="bi bi-check-circle"></i> @TempData["MensajeExito"]
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert-error-custom">
            <i class="bi bi-exclamation-triangle"></i> @TempData["MensajeError"]
        </div>
    }

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Tipo</th>
                    <th>Zona</th>
                    <th>Precio</th>
                    <th>Estado</th>
                    <th>Agente</th>
                    <th>Operación</th>
                    <th>Fecha Cierre</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-4">No hay propiedades registradas</td>
                    </tr>
                }
                else
                {
                    @foreach (var prop in Model)
                    {
                        <tr>
                            <td><strong>@prop.Tipo</strong></td>
                            <td>@prop.Zona</td>
                            <td>@prop.Moneda @prop.Precio.ToString("N2")</td>
                            <td>
                                @if (prop.Estado == "Disponible")
                                {
                                    <span class="badge-disponible">@prop.Estado</span>
                                }
                                else if (prop.Estado == "Reservado")
                                {
                                    <span class="badge-reservado">@prop.Estado</span>
                                }
                                else
                                {
                                    <span class="badge-vendido">@prop.Estado</span>
                                }
                            </td>
                            <td>@prop.NombreAgente</td>
                            <td>@(prop.TipoOperacion ?? "-")</td>
                            <td>@(prop.FechaCierre?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="DetallePropiedad" asp-route-id="@prop.Id"
                                       class="btn-action" title="Ver detalle">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (string.IsNullOrEmpty(prop.TipoOperacion))
                                    {
                                        <a asp-action="CerrarOperacion" asp-route-id="@prop.Id"
                                           class="btn-action" title="Cerrar operación"
                                           style="color:#6B6B43;">
                                            <i class="bi bi-cash-coin"></i>
                                        </a>
                                    }
                                    <a asp-action="EditarPropiedad" asp-route-id="@prop.Id"
                                       class="btn-action" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="EliminarPropiedad" asp-route-id="@prop.Id" method="post"
                                          onsubmit="return confirm('¿Eliminar esta propiedad?');"
                                          style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-action btn-action-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>